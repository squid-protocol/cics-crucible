* cics-crucible condition-handling / hc-fetch-nosuspend
DEFINE PROGRAM(HCNSPR) GROUP(CRUCHC) LANGUAGE(COBOL)
DEFINE PROGRAM(HCNSCH) GROUP(CRUCHC) LANGUAGE(COBOL)
DEFINE TRANSACTION(HCNS) GROUP(CRUCHC) PROGRAM(HCNSPR)
DEFINE TRANSACTION(HCNC) GROUP(CRUCHC) PROGRAM(HCNSCH)
* T001 accepts automatic transaction initiation (START TERMID): SPEC section 2
DEFINE TYPETERM(CRU3278) GROUP(CRUCHC) DEVICE(3270) TERMMODEL(2)
       ATI(YES) TTI(YES)
DEFINE TERMINAL(T001) GROUP(CRUCHC) TYPETERM(CRU3278)
