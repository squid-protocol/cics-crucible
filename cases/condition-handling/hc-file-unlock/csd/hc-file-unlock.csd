* cics-crucible condition-handling / hc-file-unlock
DEFINE PROGRAM(HCUNLK) GROUP(CRUCHC) LANGUAGE(COBOL)
DEFINE TRANSACTION(HC81) GROUP(CRUCHC) PROGRAM(HCUNLK)
* the file the case reads and rewrites: a local VSAM KSDS, seeded from data/HCUF.dat, opened on first use
DEFINE FILE(HCUF) GROUP(CRUCHC) DSNAME(CRUCIBLE.HC.UFILE)
       STATUS(ENABLED) OPENTIME(FIRSTREF)
       ADD(NO) BROWSE(NO) DELETE(NO) READ(YES) UPDATE(YES)
* T001 accepts automatic transaction initiation (START TERMID): SPEC section 2
DEFINE TYPETERM(CRU3278) GROUP(CRUCHC) DEVICE(3270) TERMMODEL(2)
       ATI(YES) TTI(YES)
DEFINE TERMINAL(T001) GROUP(CRUCHC) TYPETERM(CRU3278)
