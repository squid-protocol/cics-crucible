***********************************************************************
* cics-crucible  condition-handling / hc-inquire-deleteq   (Apache-2.0)
* Mapset HCSET2: HCM2 (one unprotected field).
***********************************************************************
HCSET2   DFHMSD TYPE=&SYSPARM,MODE=INOUT,LANG=COBOL,STORAGE=AUTO,      X
               TIOAPFX=YES,CTRL=(FREEKB)
HCM2     DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
         DFHMDF POS=(1,1),LENGTH=5,ATTRB=(ASKIP,BRT),INITIAL='NAME?'
NAME     DFHMDF POS=(3,10),LENGTH=12,ATTRB=(UNPROT,NORM,IC,FSET)
         DFHMDF POS=(3,23),LENGTH=1,ATTRB=(ASKIP,NORM)
         DFHMSD TYPE=FINAL
         END
