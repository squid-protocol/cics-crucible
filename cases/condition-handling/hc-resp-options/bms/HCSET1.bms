***********************************************************************
* cics-crucible  condition-handling / hc-resp-options   (Apache-2.0)
* Mapset HCSET1: HCM1 (one unprotected field).
***********************************************************************
HCSET1   DFHMSD TYPE=&SYSPARM,MODE=INOUT,LANG=COBOL,STORAGE=AUTO,      X
               TIOAPFX=YES,CTRL=(FREEKB)
HCM1     DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
         DFHMDF POS=(1,1),LENGTH=5,ATTRB=(ASKIP,BRT),INITIAL='NAME?'
NAME     DFHMDF POS=(3,10),LENGTH=12,ATTRB=(UNPROT,NORM,IC,FSET)
         DFHMDF POS=(3,23),LENGTH=1,ATTRB=(ASKIP,NORM)
         DFHMSD TYPE=FINAL
         END
