{
  "format": "cics-crucible/case/1",
  "id": "hc-handle-aid",
  "trap": "condition-handling",
  "title": "HANDLE AID on a terminal RECEIVE: a key's own label, ANYKEY (not ENTER), a deactivated key, RESP, PUSH / POP HANDLE, and CLEAR / PA1 with no data",
