* cics-crucible condition-handling / hc-file-write
DEFINE PROGRAM(HCWRIT) GROUP(CRUCHC) LANGUAGE(COBOL)
DEFINE TRANSACTION(HC92) GROUP(CRUCHC) PROGRAM(HCWRIT)
* T001 accepts automatic transaction initiation (START TERMID): SPEC section 2
DEFINE TYPETERM(CRU3278) GROUP(CRUCHC) DEVICE(3270) TERMMODEL(2)
       ATI(YES) TTI(YES)
DEFINE TERMINAL(T001) GROUP(CRUCHC) TYPETERM(CRU3278)
DEFINE FILE(HCWF) GROUP(CRUCHC) DSNAME(CRUCIBLE.HC.WFILE) STATUS(ENABLED)
       OPENTIME(FIRSTREF) ADD(YES) BROWSE(NO) DELETE(NO) READ(YES) UPDATE(NO)
