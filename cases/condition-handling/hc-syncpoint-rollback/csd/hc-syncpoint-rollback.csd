* cics-crucible condition-handling / hc-syncpoint-rollback
DEFINE PROGRAM(HCSYNC) GROUP(CRUCHC) LANGUAGE(COBOL)
DEFINE PROGRAM(HCSYNB) GROUP(CRUCHC) LANGUAGE(COBOL)
DEFINE TRANSACTION(HC91) GROUP(CRUCHC) PROGRAM(HCSYNC)
* T001 accepts automatic transaction initiation (START TERMID): SPEC section 2
DEFINE TYPETERM(CRU3278) GROUP(CRUCHC) DEVICE(3270) TERMMODEL(2)
       ATI(YES) TTI(YES)
DEFINE TERMINAL(T001) GROUP(CRUCHC) TYPETERM(CRU3278)
DEFINE FILE(HCSF) GROUP(CRUCHC) DSNAME(CRUCIBLE.HC.SFILE) STATUS(ENABLED)
       OPENTIME(FIRSTREF) ADD(NO) BROWSE(NO) DELETE(NO) READ(YES) UPDATE(YES)
