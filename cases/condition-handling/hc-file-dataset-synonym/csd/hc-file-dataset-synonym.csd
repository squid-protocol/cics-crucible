* cics-crucible condition-handling / hc-file-dataset-synonym
DEFINE PROGRAM(HCDSET) GROUP(CRUCHC) LANGUAGE(COBOL)
DEFINE TRANSACTION(HC90) GROUP(CRUCHC) PROGRAM(HCDSET)
* T001 accepts automatic transaction initiation (START TERMID): SPEC section 2
DEFINE TYPETERM(CRU3278) GROUP(CRUCHC) DEVICE(3270) TERMMODEL(2)
       ATI(YES) TTI(YES)
DEFINE TERMINAL(T001) GROUP(CRUCHC) TYPETERM(CRU3278)
DEFINE FILE(HCDS) GROUP(CRUCHC) DSNAME(CRUCIBLE.HC.DSYN) STATUS(ENABLED)
       OPENTIME(FIRSTREF) ADD(YES) BROWSE(NO) DELETE(YES) READ(YES) UPDATE(YES)
