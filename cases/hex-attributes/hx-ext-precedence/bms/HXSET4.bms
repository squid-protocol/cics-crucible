***********************************************************************
* cics-crucible  hex-attributes / hx-ext-precedence   (Apache-2.0)
* Mapset HXSET4, map HXM4: where a field's colour and highlight come
* from. Mapset COLOR=GREEN, HILIGHT=UNDERLINE; map COLOR=BLUE.
***********************************************************************
HXSET4   DFHMSD TYPE=&SYSPARM,MODE=INOUT,LANG=COBOL,STORAGE=AUTO,      X
               TIOAPFX=YES,CTRL=(FREEKB),MAPATTS=(COLOR,HILIGHT),      X
               DSATTS=(COLOR,HILIGHT),COLOR=GREEN,HILIGHT=UNDERLINE
HXM4     DFHMDI SIZE=(24,80),LINE=1,COLUMN=1,COLOR=BLUE
         DFHMDF POS=(1,1),LENGTH=15,ATTRB=(ASKIP,BRT),                 X
               INITIAL='HX04 PRECEDENCE'
FA       DFHMDF POS=(3,1),LENGTH=8,ATTRB=(ASKIP,NORM),COLOR=RED,       X
               HILIGHT=BLINK
FB       DFHMDF POS=(4,1),LENGTH=8,ATTRB=(ASKIP,NORM)
FC       DFHMDF POS=(5,1),LENGTH=8,ATTRB=(ASKIP,NORM),HILIGHT=REVERSE
         DFHMSD TYPE=FINAL
         END
