***********************************************************************
* cics-crucible  hex-attributes / hx-cursor-offset   (Apache-2.0)
* Mapset HXSET5, map HXM5. Every INITIAL is exactly its field length.
***********************************************************************
HXSET5   DFHMSD TYPE=&SYSPARM,MODE=INOUT,LANG=COBOL,STORAGE=AUTO,      X
               TIOAPFX=YES,CTRL=(FREEKB)
HXM5     DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
         DFHMDF POS=(1,1),LENGTH=15,ATTRB=(ASKIP,BRT),                 X
               INITIAL='HX05 CURSOR POS'
MSG      DFHMDF POS=(3,1),LENGTH=12,ATTRB=(ASKIP,NORM)
         DFHMDF POS=(5,1),LENGTH=5,ATTRB=(ASKIP,NORM),INITIAL='ACCT:'
ACCT     DFHMDF POS=(5,7),LENGTH=8,ATTRB=(UNPROT,NORM,IC)
         DFHMDF POS=(5,16),LENGTH=1,ATTRB=(ASKIP,NORM)
         DFHMDF POS=(6,1),LENGTH=5,ATTRB=(ASKIP,NORM),INITIAL='NOTE:'
NOTE     DFHMDF POS=(6,7),LENGTH=8,ATTRB=(UNPROT,NORM)
         DFHMDF POS=(6,16),LENGTH=1,ATTRB=(ASKIP,NORM)
         DFHMSD TYPE=FINAL
         END
