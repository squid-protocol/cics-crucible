* cics-crucible ghost-tasks / gt-web-server-send
DEFINE PROGRAM(GTWSEND) GROUP(CRUCGT) LANGUAGE(COBOL)
* The alias transaction of the URIMAP: it runs the URIMAP's program
DEFINE TRANSACTION(GT83) GROUP(CRUCGT) PROGRAM(GTWSEND)
* T001 accepts automatic transaction initiation: SPEC section 2
DEFINE TYPETERM(CRU3278) GROUP(CRUCGT) DEVICE(3270) TERMMODEL(2)
       ATI(YES) TTI(YES)
DEFINE TERMINAL(T001) GROUP(CRUCGT) TYPETERM(CRU3278)
DEFINE URIMAP(SENDURI) GROUP(CRUCGT) USAGE(SERVER) SCHEME(HTTP)
       HOST(*) PATH(/gt/send) TRANSACTION(GT83) PROGRAM(GTWSEND)
