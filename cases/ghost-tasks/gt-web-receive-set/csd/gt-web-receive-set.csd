* cics-crucible ghost-tasks / gt-web-receive-set
DEFINE PROGRAM(GTWRSET) GROUP(CRUCGT) LANGUAGE(COBOL)
* The alias transaction of the URIMAP: it runs the URIMAP's program
DEFINE TRANSACTION(GT87) GROUP(CRUCGT) PROGRAM(GTWRSET)
* T001 accepts automatic transaction initiation: SPEC section 2
DEFINE TYPETERM(CRU3278) GROUP(CRUCGT) DEVICE(3270) TERMMODEL(2)
       ATI(YES) TTI(YES)
DEFINE TERMINAL(T001) GROUP(CRUCGT) TYPETERM(CRU3278)
DEFINE URIMAP(RSETURI) GROUP(CRUCGT) USAGE(SERVER) SCHEME(HTTP)
       HOST(*) PATH(/gt/rset) TRANSACTION(GT87) PROGRAM(GTWRSET)
