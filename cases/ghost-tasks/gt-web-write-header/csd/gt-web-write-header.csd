* cics-crucible ghost-tasks / gt-web-write-header
DEFINE PROGRAM(GTWWHL) GROUP(CRUCGT) LANGUAGE(COBOL)
* The alias transaction of the URIMAP: it runs the URIMAP's program
DEFINE TRANSACTION(GT90) GROUP(CRUCGT) PROGRAM(GTWWHL)
* T001 accepts automatic transaction initiation: SPEC section 2
DEFINE TYPETERM(CRU3278) GROUP(CRUCGT) DEVICE(3270) TERMMODEL(2)
       ATI(YES) TTI(YES)
DEFINE TERMINAL(T001) GROUP(CRUCGT) TYPETERM(CRU3278)
DEFINE URIMAP(WHURI) GROUP(CRUCGT) USAGE(SERVER) SCHEME(HTTP)
       HOST(*) PATH(/gt/wh) TRANSACTION(GT90) PROGRAM(GTWWHL)
