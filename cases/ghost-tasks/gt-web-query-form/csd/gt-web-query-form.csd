* cics-crucible ghost-tasks / gt-web-query-form
DEFINE PROGRAM(GTWQRY) GROUP(CRUCGT) LANGUAGE(COBOL)
DEFINE PROGRAM(GTWFRM) GROUP(CRUCGT) LANGUAGE(COBOL)
* The alias transactions of the URIMAPs: each runs its URIMAP's program
DEFINE TRANSACTION(GT83) GROUP(CRUCGT) PROGRAM(GTWQRY)
DEFINE TRANSACTION(GT84) GROUP(CRUCGT) PROGRAM(GTWFRM)
* T001 accepts automatic transaction initiation: SPEC section 2
DEFINE TYPETERM(CRU3278) GROUP(CRUCGT) DEVICE(3270) TERMMODEL(2)
       ATI(YES) TTI(YES)
DEFINE TERMINAL(T001) GROUP(CRUCGT) TYPETERM(CRU3278)
DEFINE URIMAP(QRYURI) GROUP(CRUCGT) USAGE(SERVER) SCHEME(HTTP)
       HOST(*) PATH(/gt/qry) TRANSACTION(GT83) PROGRAM(GTWQRY)
DEFINE URIMAP(FRMURI) GROUP(CRUCGT) USAGE(SERVER) SCHEME(HTTP)
       HOST(*) PATH(/gt/frm) TRANSACTION(GT84) PROGRAM(GTWFRM)
