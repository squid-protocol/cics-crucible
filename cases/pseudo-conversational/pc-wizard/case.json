{
  "format": "cics-crucible/case/1",
  "id": "pc-wizard",
  "trap": "pseudo-conversational",
  "title": "A three-screen wizard: state in the COMMAREA, a TRANSID that changes per step, MAPFAIL, CLEAR, PF3, and PF7 back via XCTL",
  "clock": "2026-03-02T10:00:00",
  "terminal": "T001",
  "sources": {"cobol": ["src/PCWIZ.cbl", "src/PCCONF.cbl"], "bms": ["bms/PCSET.bms"], "csd": ["csd/pc-wizard.csd"],
              "copy": ["copy"], "data": []},
  "layouts": {"STATE": {"source": "src/PCWIZ.cbl", "record": "WS-STATE"}},
  "maps": {"PCM1": {"mapset": "PCSET", "copybook": "copy/PCSET.cpy"},
           "PCM2": {"mapset": "PCSET", "copybook": "copy/PCSET.cpy"},
           "PCM3": {"mapset": "PCSET", "copybook": "copy/PCSET.cpy"}},
  "scenarios": [
    {"id": "happy-post", "path": "happy",
     "summary": "PC01 -> name -> amount 12550 cents -> confirm -> posted; four tasks, three transids",
     "steps": [{"at": 0, "aid": "ENTER", "text": "PC01"},
               {"at": 10, "aid": "ENTER", "map": "PCM1", "fields": {"NAME": "ADA LOVELACE"}},
               {"at": 20, "aid": "ENTER", "map": "PCM2", "fields": {"AMT": "12550"}},
               {"at": 30, "aid": "ENTER"}]},
    {"id": "mapfail-clear-cancel", "path": "trap",
     "summary": "ENTER with nothing typed (MAPFAIL), CLEAR (no RECEIVE), a name, then PF3 on the amount screen, handled by the other program",
     "steps": [{"at": 0, "aid": "ENTER", "text": "PC01"},
               {"at": 10, "aid": "ENTER", "map": "PCM1", "fields": {}},
               {"at": 20, "aid": "CLEAR"},
               {"at": 30, "aid": "ENTER", "map": "PCM1", "fields": {"NAME": "GRACE"}},
               {"at": 40, "aid": "PF3"}]},
    {"id": "back-and-fix", "path": "trap",
     "summary": "amount 999, PF7 on the confirm screen XCTLs back to PCWIZ under transid PC03, the amount is retyped as 100000, then posted",
     "steps": [{"at": 0, "aid": "ENTER", "text": "PC01"},
               {"at": 10, "aid": "ENTER", "map": "PCM1", "fields": {"NAME": "ALAN"}},
               {"at": 20, "aid": "ENTER", "map": "PCM2", "fields": {"AMT": "999"}},
               {"at": 30, "aid": "PF7"},
               {"at": 40, "aid": "ENTER", "map": "PCM2", "fields": {"AMT": "100000"},
                "note": "the operator erases the redisplayed 0000999 with ERASE EOF and types 100000"},
               {"at": 50, "aid": "ENTER"}]}
  ]
}
